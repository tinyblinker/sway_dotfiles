# Never commit the age private key or the plaintext config (they hold secrets).
age-key.txt
config.yaml

# Runtime caches (downloaded at first start; may hold proxy creds).
providers/   # subscription cache
ui/          # metacubexd dashboard
rules/       # rule-provider cache (.mrs files)
cache/       # mmdb / geodata cache

# Safe to commit / make public:
#   config.enc.yaml          (sops-encrypted, secrets sealed)
#   .sops.yaml               (age public key only)
#   encrypt.sh / decrypt.sh
/example.yaml
